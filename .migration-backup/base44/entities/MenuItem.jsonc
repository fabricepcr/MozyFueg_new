{
  "name": "MenuItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del producto"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n del producto"
    },
    "price": {
      "type": "number",
      "description": "Precio en euros (para bebidas) o precio 33cm para pizzas"
    },
    "price_23cm": {
      "type": "number",
      "description": "Precio en euros para tama\u00f1o 24cm (solo pizzas)"
    },
    "category": {
      "type": "string",
      "enum": [
        "pizzas",
        "pizzas_dulces",
        "bebidas"
      ],
      "description": "Categor\u00eda del producto"
    },
    "image_url": {
      "type": "string",
      "description": "URL de la imagen del producto"
    },
    "available": {
      "type": "boolean",
      "default": true,
      "description": "Si el producto est\u00e1 disponible"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Orden de visualizaci\u00f3n"
    }
  },
  "required": [
    "name",
    "price",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}