{
  "name": "DeliverySettings",
  "type": "object",
  "properties": {
    "singleton_key": {
      "type": "string",
      "description": "Clave \u00fanica para upsert (siempre 'main')",
      "default": "main"
    },
    "mode": {
      "type": "string",
      "enum": [
        "manual",
        "schedule"
      ],
      "default": "manual",
      "description": "Modo de control: manual o por horario"
    },
    "manual_active": {
      "type": "boolean",
      "default": true,
      "description": "Estado manual del delivery (activo/inactivo)"
    },
    "pickup_active": {
      "type": "boolean",
      "default": true,
      "description": "Si la recogida en local est\u00e1 activa"
    },
    "schedule": {
